# Copy to .env.test.local and fill in. Never commit .env.test.local.

# Local e2e overrides, loaded by playwright.config.ts on top of .env.local.
# Keeps `.env.local`'s normal-dev values (e.g. a real AI_PROVIDER + Gemini
# key) untouched while e2e runs deterministically against a mock provider,
# mirroring the `test:e2e` job env in .github/workflows/ci.yml.

DEMO_PASSWORD=ci-e2e-demo-password
DEMO_COOKIE_SECRET=ci-e2e-demo-cookie-secret-not-a-real-secret-32b
AI_PROVIDER=mock
