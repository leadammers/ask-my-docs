# Copy to .env.local and fill in. Never commit .env.local.

# Local development uses the local Supabase stack (values from `supabase status`).
# Production values live only in Vercel.

# --- Demo password gate (in front of everything else) ---
DEMO_PASSWORD=                      # shared with reviewers out of band
DEMO_COOKIE_SECRET=                 # openssl rand -hex 32

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# --- AI provider ---
AI_PROVIDER=google                  # google | openai-compatible | ollama | mock (E2E/CI only)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_CHAT_MODEL=                      # current Gemini Flash model ID (check Google AI Studio)
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768         # must match vector(768) in the schema
AI_TTS_MODEL=                       # current Gemini TTS model ID (check Google AI Studio)
AI_TTS_VOICE_HOST=                  # prebuilt voice name, chosen in T11
AI_TTS_VOICE_GUEST=
MIN_VECTOR_SIMILARITY=0.5           # below this, answer "not in your sources" without calling the model

# Optional, for local development with Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Required only when AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- Abuse protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # empty locally (CAPTCHA off in local stack); set in Vercel only
AI_GLOBAL_DAILY_CAP=500             # model calls per day across all users (circuit breaker)

# --- Limits ---
RATE_LIMIT_CHAT_PER_MIN=10
RATE_LIMIT_INGEST_PER_HOUR=20
RATE_LIMIT_AUDIO_PER_DAY=3
MAX_UPLOAD_MB=10
MAX_SOURCES_PER_NOTEBOOK=10
